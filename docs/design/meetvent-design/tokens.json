{
  "$meta": {
    "name": "Meetvent",
    "version": "1.2.0",
    "note": "accentFill and accentText are derived from accent (darken until contrast vs white >= 3.1 / >= 4.6). Recompute them if accent changes."
  },
  "color": {
    "accent": "#F57C3F",
    "accentFill": "#E07139",
    "accentText": "#B1592D",
    "accentSoft": "#FEEFE8",
    "accentLine": "#FAB795",
    "accentOptions": ["#F57C3F", "#F59A4A", "#EF6F5A", "#E8803A"],
    "ink": "#2A2420",
    "inkBody": "#4A413C",
    "muted": "#6F6660",
    "tabInactive": "#776E68",
    "iconMuted": "#8A817B",
    "bg": "#FFFFFF",
    "bgWarm": "#FCFAF8",
    "surfaceMuted": "#F4F0EC",
    "tintCard": "#FCF7F3",
    "tintCardBorder": "#F3E8DF",
    "border": "#EFE9E4",
    "borderControl": "#E8E1DB",
    "divider": "#F2ECE7",
    "toggleOff": "#DDD4CD",
    "danger": "#B23A2A",
    "dangerBorder": "#E6A79B",
    "onAccentFill": "#FFFFFF",
    "overlayPhoto": "linear-gradient(to top, rgba(42,36,32,0.78), rgba(42,36,32,0))"
  },
  "font": {
    "family": "DM Sans",
    "fallback": "system-ui, sans-serif",
    "weights": [400, 500, 600, 700],
    "size": {
      "tab": 11,
      "meta": 12,
      "label": 13,
      "body": 14,
      "bodyLg": 15,
      "button": 16,
      "section": 18,
      "page": 24,
      "hero": 26,
      "profileName": 28
    },
    "letterSpacing": { "page": "-0.01em" },
    "lineHeight": { "tight": 1.2, "body": 1.5, "relaxed": 1.6 }
  },
  "space": { "xxs": 4, "xs": 6, "sm": 8, "md": 10, "lg": 12, "xl": 14, "2xl": 20, "3xl": 24, "screenX": 20, "screenXAuth": 24 },
  "radius": { "thumbSm": 10, "thumb": 12, "input": 14, "card": 16, "cardLg": 18, "photo": 20, "pill": 999 },
  "size": {
    "touch": 44,
    "buttonPrimary": 50,
    "input": 48,
    "search": 46,
    "chip": 34,
    "iconButton": 44,
    "tabBar": 82,
    "avatarXs": 28,
    "avatarSm": 38,
    "avatarMd": 50,
    "avatarLg": 96,
    "eventThumb": 68,
    "toggleW": 46,
    "toggleH": 28
  },
  "shadow": {
    "card": "none (use 1px border)",
    "swipeCard": "0 6px 20px rgba(42,36,32,0.10)",
    "floating": "0 4px 14px rgba(42,36,32,0.08)",
    "toast": "0 4px 16px rgba(42,36,32,0.15)"
  },
  "icon": { "library": "lucide", "stroke": 1.6, "strokeActive": 1.8, "size": [18, 20, 22] }
}
